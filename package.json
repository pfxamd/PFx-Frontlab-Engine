{
  "name": "@pfxamd/frontlab-engine",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Isolated browser-native HTML/CSS/JavaScript preview runtime",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.55.0"
  }
}
