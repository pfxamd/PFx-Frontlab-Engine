{
  "name": "@pfxamd/frontlab-engine",
  "version": "0.3.0-alpha.0",
  "type": "module",
  "private": true,
  "description": "Isolated browser-native HTML/CSS/JavaScript preview runtime",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "version.json",
    "version-badge.svg"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "benchmark": "node benchmarks/compose.mjs",
    "build:runner": "node scripts/prepare-preview-host.mjs",
    "verify:runner": "node scripts/verify-preview-host.mjs",
    "prepare": "npm run build",
    "release:version": "node .pfx/release.mjs --sync"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0"
  }
}
